{
  "openapi": "3.1.0",
  "info": {
    "title": "GPSS Patent Search MCP",
    "description": "MCP tools for searching patents in the Global Patent Search System",
    "version": "1.0.0"
  },
  "paths": {
    "/tools/search_patents": {
      "post": {
        "summary": "Tool Search Patents",
        "description": "MCP Tool endpoint for patent search.\n\nThis tool searches the GPSS (Global Patent Search System) for patents matching\nyour keywords. Authentication is handled automatically via the USER_CODE\nenvironment variable.\n\nSimply provide your search keywords and optional filters. The tool will:\n\n1. Automatically read USER_CODE from the environment\n\n2. Send the request to GPSS API\n\n3. Return parsed results with patent numbers, titles, abstracts, and inventor info",
        "operationId": "tool_search_patents_tools_search_patents_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchPatentsRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchPatentsResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/tools/get_available_databases": {
      "post": {
        "summary": "Tool Get Databases",
        "description": "MCP Tool endpoint for getting available databases.",
        "operationId": "tool_get_databases_tools_get_available_databases_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DatabasesResponse"
                }
              }
            }
          }
        }
      }
    },
    "/tools/get_search_examples": {
      "post": {
        "summary": "Tool Get Examples",
        "description": "MCP Tool endpoint for getting search examples.",
        "operationId": "tool_get_examples_tools_get_search_examples_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchExamplesResponse"
                }
              }
            }
          }
        }
      }
    }
  },
